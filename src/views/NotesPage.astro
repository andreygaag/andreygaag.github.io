---
import BaseLayout from '../layouts/BaseLayout.astro';
import NoteCard from '../components/NoteCard.astro';
import { byPubDateDesc, getLocalizedNotes } from '../data/collections';
import { UI, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const messages = UI[locale];
const notes = (await getLocalizedNotes(locale)).sort(byPubDateDesc);
---

<BaseLayout
  title={`${messages.notes.heading} - Andrey Gaag`}
  description={messages.notes.description}
  locale={locale}
  translationPath="notes"
>
  <h1>{messages.notes.heading}</h1>
  {
    notes.length === 0 ? (
      <p>{messages.notes.empty}</p>
    ) : (
      notes.map((note) => <NoteCard note={note} locale={locale} />)
    )
  }
</BaseLayout>
