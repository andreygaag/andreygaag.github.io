---
import BaseLayout from '../layouts/BaseLayout.astro';
import NoteCard from '../components/NoteCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { byPubDateDesc, getLocalizedNotes } from '../data/collections';
import { getProjects } from '../data/projects';
import { localizedRoute } from '../astro-i18n';
import { UI, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const messages = UI[locale];
const latestNotes = (await getLocalizedNotes(locale)).sort(byPubDateDesc).slice(0, 4);
const featuredProjects = getProjects(locale).slice(0, 3);
const introLinks = [
  {
    href: localizedRoute(locale, 'notes/2026-08-14-dynamic-system-prompt-tail-breaks-cache'),
    label: messages.home.flagshipCta,
    kind: 'primary',
  },
  {
    href: 'https://t.me/moveax3',
    label: messages.home.contactCta,
    kind: 'secondary',
  },
] as const;
---

<BaseLayout
  title={messages.site.title}
  description={messages.site.description}
  locale={locale}
>
  <section class="intro">
    <h1>Andrey Gaag</h1>
    <p class="lead">{messages.home.lead}</p>
    <p class="positioning">{messages.home.positioning}</p>
    <nav class="intro-links" aria-label={messages.navigation.primaryLinksLabel}>
      {
        introLinks.map(({ href, label, kind }) => (
          <a class={`cta cta-${kind}`} href={href}>{label}</a>
        ))
      }
    </nav>
  </section>

  <section aria-labelledby="notes-heading">
    <div class="section-head">
      <h2 id="notes-heading">{messages.home.latestNotes}</h2>
      <a href={localizedRoute(locale, 'notes')}>{messages.home.allNotes}</a>
    </div>
    {
      latestNotes.length === 0 ? (
        <p>{messages.notes.empty}</p>
      ) : (
        latestNotes.map((note) => <NoteCard note={note} locale={locale} />)
      )
    }
  </section>

  <section aria-labelledby="projects-heading">
    <div class="section-head">
      <h2 id="projects-heading">{messages.home.featuredProjects}</h2>
      <a href={localizedRoute(locale, 'projects')}>{messages.home.allProjects}</a>
    </div>
    {
      featuredProjects.map((project) => <ProjectCard project={project} locale={locale} />)
    }
  </section>
</BaseLayout>

<style>
  .intro {
    padding-bottom: calc(var(--space) * 1.5);
  }

  .lead {
    font-size: 1.2rem;
    line-height: 1.6;
    max-width: 42rem;
  }

  .positioning {
    color: var(--color-muted);
    max-width: 38rem;
  }

  .intro-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space);
    margin-top: var(--space);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--color-text);
    border-radius: 0.4rem;
    font-weight: 600;
  }

  .cta:hover,
  .cta:focus {
    text-decoration: none;
  }

  .cta:focus-visible {
    outline: 3px solid var(--color-link);
    outline-offset: 2px;
  }

  .cta-primary {
    color: var(--color-background);
    background: var(--color-text);
  }

  .cta-primary:hover {
    opacity: 0.85;
  }

  .cta-secondary {
    color: var(--color-text);
  }

  .cta-secondary:hover {
    background: var(--color-surface);
  }

  section + section {
    margin-top: calc(var(--space) * 2);
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space);
  }

  .section-head h2 {
    margin: 0;
  }
</style>
