---
import type { GetStaticPaths } from 'astro';
import ArticlePage from '../../../views/ArticlePage.astro';
import { contentSlug, getLocalizedArticles } from '../../../data/collections';

export const getStaticPaths = (async () => {
  const articles = await getLocalizedArticles('ru');
  return articles.map((entry) => ({ params: { slug: contentSlug(entry) }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
---

<ArticlePage entry={entry} locale="ru" />
